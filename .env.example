# Is file ko copy karke .env banao aur asli values bharo. .env ko kabhi git me mat daalo.

# ---- Server ----
PORT=5050
# Frontend ka URL (CORS aur socket ke liye). Production me apna domain likho.
FRONTEND_URL=http://localhost:3000

# ---- Database / Auth ----
CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# ---- AI provider (Google Gemini) ----
GoogleGenAI_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# EMBED_MODEL=gemini-embedding-001

# ---- Vector DB (Qdrant) ----
# Cloud: https://<id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# ---- Retrieval (optional) ----
# RAG_MIN_SCORE=0.6
# RAG_TOP_K=3

# ---- Limits (optional, per user, 15 minute window) ----
# AI_RATE_LIMIT=20
# ASSISTANT_RATE_LIMIT=30
# AGENT_AI_RATE_LIMIT=60
# ADMIN_AI_RATE_LIMIT=30
# MAX_MESSAGE_LENGTH=1000
# MAX_QUESTION_LENGTH=500
# MAX_OUTPUT_TOKENS=2048

# ---- Cost estimate on AI Monitoring page (USD per 1 million tokens, provider ka rate) ----
# AI_COST_PER_1M_INPUT=
# AI_COST_PER_1M_OUTPUT=
# APP_TIMEZONE=Asia/Kolkata
